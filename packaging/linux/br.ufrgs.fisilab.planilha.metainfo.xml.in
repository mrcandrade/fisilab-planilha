<?xml version="1.0" encoding="UTF-8"?>
<!-- AppStream metadata (software centres, Flathub). Template: package.sh and the Flatpak
     manifest substitute @VERSION@ and @DATE@ from Cargo.toml and the build date. -->
<component type="desktop-application">
  <id>br.ufrgs.fisilab.planilha</id>
  <metadata_license>CC0-1.0</metadata_license>
  <project_license>MIT OR Apache-2.0</project_license>
  <name>Planilha</name>
  <summary>Planilhas — Suíte FisiLab (alternativa livre)</summary>
  <developer id="br.ufrgs.fisilab">
    <name>FisiLab — LARFIC</name>
  </developer>
  <description>
    <p>
      A Planilha é uma planilha eletrônica nativa e livre da Suíte FisiLab. Abre e salva pastas de
      trabalho .xlsx e arquivos CSV/TSV, calcula centenas de funções e formata, ordena, filtra e
      cria gráficos com os seus dados.
    </p>
    <p>
      Baseado no GridCraft, do ArtCraft Team e contribuidores (MIT ou Apache 2.0). Inclui a
      ferramenta de linha de comando fisilab-planilha-cli, que avalia e converte pastas de trabalho
      sem abrir a janela.
    </p>
  </description>
  <launchable type="desktop-id">br.ufrgs.fisilab.planilha.desktop</launchable>
  <icon type="stock">br.ufrgs.fisilab.planilha</icon>
  <!-- Only url types known to appstream 0.15 (Ubuntu 22.04, where CI validates): no vcs-browser. -->
  <url type="homepage">https://github.com/mrcandrade/larfic</url>
  <url type="bugtracker">https://github.com/mrcandrade/fisilab-planilha/issues</url>
  <categories>
    <category>Office</category>
    <category>Spreadsheet</category>
  </categories>
  <keywords>
    <keyword>planilha</keyword>
    <keyword>spreadsheet</keyword>
    <keyword>workbook</keyword>
    <keyword>formula</keyword>
    <keyword>xlsx</keyword>
    <keyword>csv</keyword>
  </keywords>
  <!-- Proposed app colour (verde da Planilha #1f9d55 / ink #147a40); cor proposta. -->
  <branding>
    <color type="primary" scheme_preference="light">#a7e3bf</color>
    <color type="primary" scheme_preference="dark">#147a40</color>
  </branding>
  <requires>
    <display_length compare="ge">760</display_length>
  </requires>
  <supports>
    <control>keyboard</control>
    <control>pointing</control>
  </supports>
  <provides>
    <binary>fisilab-planilha</binary>
    <binary>fisilab-planilha-cli</binary>
    <mediatype>application/vnd.openxmlformats-officedocument.spreadsheetml.sheet</mediatype>
    <mediatype>application/vnd.ms-excel.sheet.macroEnabled.12</mediatype>
    <mediatype>application/vnd.ms-excel.sheet.binary.macroEnabled.12</mediatype>
    <mediatype>application/vnd.oasis.opendocument.spreadsheet</mediatype>
    <mediatype>text/csv</mediatype>
    <mediatype>text/tab-separated-values</mediatype>
  </provides>
  <content_rating type="oars-1.1"/>
  <releases>
    <release version="@VERSION@" date="@DATE@"/>
  </releases>
</component>
